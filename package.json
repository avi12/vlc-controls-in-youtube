{
  "name": "vlc-shortcuts-for-youtube",
  "version": "0.1.1",
  "type": "module",
  "description": "VLC's keyboard controls in YouTube's player",
  "imports": {
    "#imports": "./.wxt/types/imports-module.d.ts"
  },
  "author": "Avi <avi6106@gmail.com>",
  "license": "GPL-3.0-or-later",
  "repository": "https://github.com/avi12/vlc-shortcuts-for-youtube",
  "homepage": "https://github.com/avi12/vlc-shortcuts-for-youtube",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:firefox": "tsx scripts/dev.ts --firefox",
    "dev:firefox:no-marionette": "tsx scripts/dev.ts --firefox --no-marionette",
    "dev:opera": "tsx scripts/dev.ts --opera",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "build:opera": "wxt build -b opera",
    "build:all": "pnpx concurrently \"pnpm build\" \"pnpm build:firefox\" \"pnpm build:opera\" --names \"Chrome ,Firefox,Opera  \"",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "zip:opera": "wxt zip -b opera",
    "zip:all": "pnpx concurrently \"pnpm zip\" \"pnpm zip:firefox\" \"pnpm zip:opera\" --names \"Chrome ,Firefox,Opera  \"",
    "crx": "pnpm zip && tsx scripts/pack-crx.ts",
    "lint": "pnpm fallow && oxlint --type-aware --fix -c .oxlintrc.fix.json && eslint --fix && oxlint --type-aware",
    "stylelint": "stylelint \"src/**/*.css\" --fix --allow-empty-input",
    "typecheck": "tsc --noEmit",
    "fallow": "fallow audit --base HEAD",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@webext-core/messaging": "^4.0.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.5",
    "chokidar": "^5.0.0",
    "crx3": "2.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-import-newlines": "^2.0.0",
    "eslint-plugin-perfectionist": "^5.9.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fallow": "2.103.0",
    "fflate": "^0.8.3",
    "globals": "^17.7.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2004",
    "postcss": "^8.5.30",
    "stylelint": "^17.14.0",
    "stylelint-config-ccb": "^3.32.0",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.2",
    "web-ext-run": "^0.2.4",
    "wxt": "^0.21.4"
  },
  "packageManager": "pnpm@11.1.2"
}
